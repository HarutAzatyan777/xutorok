rules_version = '2';

// ===============================================================
// Assumed Data Model — Xutorok Multi-Restaurant Digital Menu Platform
// ===============================================================
//
// This security rules file enforces strict multi-restaurant tenant isolation
// under /restaurants/{restaurantId} on the shared Firebase project.
//
// Collection: /platformAdmins/{uid}
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - active: bool (required) - Whether platform-wide super-admin access is active
//   - email: string (optional, <= 254 chars)
//   - createdAt: timestamp (optional)
//
// Collection: /restaurants/{restaurantId}
// Document ID: {restaurantId} (tenant slug, e.g. "xutorok")
// Fields:
//   - id: string (optional/immutable, must match restaurantId)
//   - restaurantId: string (optional/immutable, must match restaurantId)
//   - slug: string (required, 1..120 chars)
//   - name: map { hy, ru, en } or string (required, <= 200 chars per locale)
//   - status: string (required, 'active' | 'inactive' | 'draft' | 'suspended')
//   - description: map { hy, ru, en } (optional, <= 2000 chars per locale)
//   - currency: string (optional, 'AMD')
//   - defaultLanguage: string (optional, 'hy' | 'ru' | 'en')
//   - supportedLanguages: list (optional, <= 5 items)
//   - logoUrl: string (optional, <= 2048 chars)
//   - coverImageUrl: string (optional, <= 2048 chars)
//   - createdAt: timestamp (optional, immutable)
//   - updatedAt: timestamp (optional)
//
// Collection: /restaurants/{restaurantId}/categories/{categoryId}
// Document ID: {categoryId}
// Fields:
//   - id: string (optional)
//   - restaurantId: string (required, immutable, must match {restaurantId})
//   - slug: string (required, 1..120 chars)
//   - name: map { hy: string (1..200), ru: string (0..200), en: string (0..200) } (required)
//   - description: map { hy, ru, en } (optional, <= 1000 chars per locale)
//   - imageUrl: string (optional, <= 2048 chars)
//   - icon: string (optional, <= 120 chars)
//   - sortOrder: number (required, -10000..1000000)
//   - isVisible: bool (required)
//   - createdAt: timestamp (optional, immutable)
//   - updatedAt: timestamp (optional)
//
// Collection: /restaurants/{restaurantId}/products/{productId}
// Document ID: {productId}
// Fields:
//   - id: string (optional)
//   - restaurantId: string (required, immutable, must match {restaurantId})
//   - categoryId: string (required, 1..120 chars)
//   - slug: string (optional, <= 160 chars)
//   - sku: string (optional, <= 100 chars)
//   - name: map { hy: string (1..200), ru: string (0..200), en: string (0..200) } (required)
//   - description: map { hy, ru, en } (optional, <= 2000 chars per locale)
//   - price: number (required, >= 0, <= 100000000)
//   - currency: string (required, must equal 'AMD')
//   - imageUrl: string (optional, <= 2048 chars)
//   - images: list (optional, <= 10 items)
//   - weight: string (optional, <= 100 chars)
//   - portion: map or string (optional)
//   - variants: list (optional, <= 20 items)
//   - tags: list (optional, <= 20 items)
//   - allergens: list (optional, <= 20 items)
//   - isAvailable: bool (required)
//   - isVisible: bool (required)
//   - isFeatured: bool (required)
//   - sortOrder: number (required, -10000..1000000)
//   - createdAt: timestamp (optional, immutable)
//   - updatedAt: timestamp (optional)
//
// Collection: /restaurants/{restaurantId}/settings/{settingId}
// Document ID: 'general' | 'menu' | 'branding'
// Fields:
//   - restaurantId: string (required, immutable, must match {restaurantId})
//   - [setting-specific configuration fields]
//
// Collection: /restaurants/{restaurantId}/members/{memberUid}
// Document ID: {memberUid} (Firebase Auth UID)
// Fields:
//   - uid: string (required, immutable, must match {memberUid})
//   - restaurantId: string (required, immutable, must match {restaurantId})
//   - role: string (required, 'restaurantOwner' | 'restaurantManager')
//   - status: string (required, 'active' | 'disabled')
//   - email: string (optional, <= 254 chars)
//   - displayName: string (optional, <= 120 chars)
//   - createdAt: timestamp (optional, immutable)
//   - updatedAt: timestamp (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-scoped documents)
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Check if user is owner based on document's uid field
    function isDocOwner() {
      return isSignedIn() && request.auth.uid == resource.data.uid;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        !('uid' in resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that immutable fields have not changed during update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string (if present and non-null, must be string within bounds)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate that a list is a list and enforces size limits
    function isValidList(list, maxSize) {
      return list is list && list.size() <= maxSize;
    }

    // Validate optional list
    function isValidOptionalList(field, maxSize) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        isValidList(request.resource.data[field], maxSize);
    }

    // Validate trilingual localized text map { hy, ru, en }
    function isValidLocalizedMap(mapData, minHyLen, maxLen) {
      return mapData is map &&
        mapData.keys().hasAll(['hy', 'ru', 'en']) &&
        mapData.keys().hasOnly(['hy', 'ru', 'en']) &&
        mapData.hy is string &&
        mapData.hy.size() >= minHyLen &&
        mapData.hy.size() <= maxLen &&
        mapData.ru is string &&
        mapData.ru.size() <= maxLen &&
        mapData.en is string &&
        mapData.en.size() <= maxLen;
    }

    // Validate optional trilingual localized text map (supports Partial<LocalizedText>)
    function isValidOptionalLocalizedMap(field, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (
          request.resource.data[field] is map &&
          request.resource.data[field].keys().hasOnly(['hy', 'ru', 'en']) &&
          (!('hy' in request.resource.data[field]) || (request.resource.data[field].hy is string && request.resource.data[field].hy.size() <= maxLen)) &&
          (!('ru' in request.resource.data[field]) || (request.resource.data[field].ru is string && request.resource.data[field].ru.size() <= maxLen)) &&
          (!('en' in request.resource.data[field]) || (request.resource.data[field].en is string && request.resource.data[field].en.size() <= maxLen))
        );
    }

    // ===============================================================
    // Multi-Restaurant RBAC & Tenant Membership Helpers
    // ===============================================================

    // Platform Admin: verified via custom claim OR active document in /platformAdmins/{uid}
    function isPlatformAdmin() {
      return isSignedIn() && (
        request.auth.token.get('platformAdmin', false) == true ||
        (exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.active == true)
      );
    }

    // Fetch caller's membership document for a given restaurantId
    function getMember(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid));
    }

    // Verify caller has an active membership scoped to restaurantId
    function hasActiveMembership(restaurantId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid)) &&
        getMember(restaurantId).data.status == 'active' &&
        getMember(restaurantId).data.restaurantId == restaurantId;
    }

    // Restaurant Admin: platformAdmin OR active member with role in ['restaurantOwner', 'restaurantManager']
    function isRestaurantAdmin(restaurantId) {
      return isPlatformAdmin() || (
        hasActiveMembership(restaurantId) &&
        getMember(restaurantId).data.role in ['restaurantOwner', 'restaurantManager']
      );
    }

    // Restaurant Owner: platformAdmin OR active member with role == 'restaurantOwner'
    function isRestaurantOwner(restaurantId) {
      return isPlatformAdmin() || (
        hasActiveMembership(restaurantId) &&
        getMember(restaurantId).data.role == 'restaurantOwner'
      );
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidRestaurantDoc(restaurantId) {
      let data = request.resource.data;
      return hasRequiredFields(['slug', 'name', 'status']) &&
        (!('id' in data) || data.id == restaurantId) &&
        (!('restaurantId' in data) || data.restaurantId == restaurantId) &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 120 &&
        (
          isValidLocalizedMap(data.name, 1, 200) ||
          (data.name is string && data.name.size() > 0 && data.name.size() <= 200)
        ) &&
        data.status in ['active', 'inactive', 'draft', 'suspended'] &&
        isValidOptionalLocalizedMap('description', 2000) &&
        isValidOptionalString('currency', 1, 10) &&
        isValidOptionalString('defaultLanguage', 2, 5) &&
        isValidOptionalList('supportedLanguages', 5) &&
        isValidOptionalString('logoUrl', 0, 2048) &&
        isValidOptionalString('coverImageUrl', 0, 2048) &&
        (!('contact' in data) || data.contact == null || data.contact is map) &&
        (!('branding' in data) || data.branding == null || data.branding is map);
    }

    function isValidCategory(restaurantId) {
      let data = request.resource.data;
      return hasRequiredFields(['restaurantId', 'name', 'slug', 'sortOrder', 'isVisible']) &&
        data.restaurantId == restaurantId &&
        (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() <= 120)) &&
        isValidLocalizedMap(data.name, 1, 200) &&
        isValidOptionalLocalizedMap('description', 1000) &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 120 &&
        data.sortOrder is number && data.sortOrder >= -10000 && data.sortOrder <= 1000000 &&
        data.isVisible is bool &&
        isValidOptionalString('imageUrl', 0, 2048) &&
        isValidOptionalString('imagePath', 0, 1024) &&
        isValidOptionalString('icon', 0, 120);
    }

    function isValidProduct(restaurantId) {
      let data = request.resource.data;
      return hasRequiredFields([
          'restaurantId',
          'categoryId',
          'name',
          'price',
          'currency',
          'isAvailable',
          'isVisible',
          'isFeatured',
          'sortOrder'
        ]) &&
        data.restaurantId == restaurantId &&
        (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() <= 120)) &&
        data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 120 &&
        isValidLocalizedMap(data.name, 1, 200) &&
        isValidOptionalLocalizedMap('description', 2000) &&
        data.price is number && data.price >= 0 && data.price <= 100000000 &&
        data.currency == 'AMD' &&
        data.isAvailable is bool &&
        data.isVisible is bool &&
        data.isFeatured is bool &&
        data.sortOrder is number && data.sortOrder >= -10000 && data.sortOrder <= 1000000 &&
        isValidOptionalString('slug', 0, 160) &&
        isValidOptionalString('sku', 0, 100) &&
        isValidOptionalString('imageUrl', 0, 2048) &&
        isValidOptionalString('imagePath', 0, 1024) &&
        isValidOptionalString('weight', 0, 100) &&
        isValidOptionalList('images', 10) &&
        isValidOptionalList('variants', 20) &&
        isValidOptionalList('tags', 20) &&
        isValidOptionalList('allergens', 20);
    }

    function isValidSettings(restaurantId, settingId) {
      let data = request.resource.data;
      return settingId in ['general', 'menu', 'branding'] &&
        hasRequiredFields(['restaurantId']) &&
        data.restaurantId == restaurantId;
    }

    function isValidMember(restaurantId, memberUid) {
      let data = request.resource.data;
      return hasRequiredFields(['uid', 'restaurantId', 'role', 'status']) &&
        data.uid == memberUid &&
        data.restaurantId == restaurantId &&
        data.role in ['restaurantOwner', 'restaurantManager'] &&
        data.status in ['active', 'disabled'] &&
        isValidOptionalString('email', 0, 254) &&
        isValidOptionalString('displayName', 0, 120);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Platform Admins (server/Admin SDK provisioned only)
    match /platformAdmins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // 2. Restaurant Tenant Root
    match /restaurants/{restaurantId} {
      // Public visitors can read active restaurant profiles (and check existence);
      // restaurant admins can read their own restaurant regardless of status.
      allow get: if resource == null ||
        resource.data.status == 'active' ||
        isRestaurantAdmin(restaurantId);
      allow list: if resource.data.status == 'active' ||
        isRestaurantAdmin(restaurantId);

      // Platform admins or provisioned restaurant admins of this tenant can initialize the restaurant doc
      allow create: if isRestaurantAdmin(restaurantId) &&
        isValidRestaurantDoc(restaurantId);

      // Restaurant admins can update their own restaurant profile; immutable IDs are locked
      allow update: if isRestaurantAdmin(restaurantId) &&
        isValidRestaurantDoc(restaurantId) &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
        (!('restaurantId' in resource.data) || request.resource.data.restaurantId == resource.data.restaurantId) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if false;

      // 3. Categories Subcollection
      match /categories/{categoryId} {
        // Public visitors can read visible categories; restaurant admins can read all
        allow get: if resource == null ||
          resource.data.isVisible == true ||
          isRestaurantAdmin(restaurantId);
        allow list: if resource.data.isVisible == true ||
          isRestaurantAdmin(restaurantId);

        allow create: if isRestaurantAdmin(restaurantId) &&
          isValidCategory(restaurantId);

        allow update: if isRestaurantAdmin(restaurantId) &&
          isValidCategory(restaurantId) &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

        allow delete: if isRestaurantAdmin(restaurantId);
      }

      // 4. Products Subcollection
      match /products/{productId} {
        // Public visitors can read visible products; restaurant admins can read all
        allow get: if resource == null ||
          resource.data.isVisible == true ||
          isRestaurantAdmin(restaurantId);
        allow list: if resource.data.isVisible == true ||
          isRestaurantAdmin(restaurantId);

        allow create: if isRestaurantAdmin(restaurantId) &&
          isValidProduct(restaurantId);

        allow update: if isRestaurantAdmin(restaurantId) &&
          isValidProduct(restaurantId) &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

        allow delete: if isRestaurantAdmin(restaurantId);
      }

      // 5. Restaurant Settings Subcollection ('general', 'menu', 'branding')
      match /settings/{settingId} {
        // Public digital menu requires reading general, menu, and branding settings
        allow get, list: if true;

        allow create: if isRestaurantAdmin(restaurantId) &&
          isValidSettings(restaurantId, settingId);

        allow update: if isRestaurantAdmin(restaurantId) &&
          isValidSettings(restaurantId, settingId) &&
          request.resource.data.restaurantId == resource.data.restaurantId;

        allow delete: if false;
      }

      // 6. Restaurant Staff Memberships Subcollection (Private administrative data)
      match /members/{memberUid} {
        // Strictly private: a signed-in user may inspect their own membership document
        // to resolve their role, and restaurant admins may read/list their restaurant's members.
        allow get: if isSignedIn() && (
          request.auth.uid == memberUid ||
          isRestaurantAdmin(restaurantId)
        );
        allow list: if isRestaurantAdmin(restaurantId);

        // Platform admins can manage all members; restaurant owners can manage other members
        // in their restaurant, but cannot self-escalate or alter their own membership record.
        allow create: if (
            isPlatformAdmin() ||
            (isRestaurantOwner(restaurantId) && request.auth.uid != memberUid)
          ) &&
          isValidMember(restaurantId, memberUid);

        allow update: if (
            isPlatformAdmin() ||
            (isRestaurantOwner(restaurantId) && request.auth.uid != memberUid)
          ) &&
          isValidMember(restaurantId, memberUid) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

        allow delete: if isPlatformAdmin() ||
          (isRestaurantOwner(restaurantId) && request.auth.uid != memberUid);
      }
    }

    // ===============================================================
    // Preserved Shared Project Rules (ai-twin-conflicts)
    // ===============================================================

    match /arena_matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if false; // Only serverless functions update match statuses

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Default Deny: Explicitly reject reads and writes to all other collections/paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
