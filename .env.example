# Restaurant Tenant Configuration (default: "xutorok")
VITE_RESTAURANT_ID=xutorok

# Firebase Client Configuration (Project: ai-twin-conflicts)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=ai-twin-conflicts.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-twin-conflicts
VITE_FIREBASE_STORAGE_BUCKET=ai-twin-conflicts.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=562120240186
VITE_FIREBASE_APP_ID=your_app_id_here

# Optional Emulator Flag (set to "true" to use local Firebase Emulators)
VITE_USE_FIREBASE_EMULATOR=false
